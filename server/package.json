{
  "name": "folio-voice-server",
  "version": "1.0.0",
  "description": "Folio Voice backend API with Express and Knex",
  "main": "src/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node src/index.js",
    "start:prod": "knex migrate:latest && node src/index.js",
    "dev": "node --watch src/index.js",
    "migrate:latest": "knex migrate:latest",
    "migrate:rollback": "knex migrate:rollback"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "pg": "^8.23.1"
  },
  "optionalDependencies": {
    "sqlite3": "^5.1.7"
  }
}